# =============================================================================
# Lots of Network API — Environment Variables
# api.lotsofnetwork.com
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked [REQUIRED] below.
#   3. Run the server:  uvicorn app.main:app --reload --port 8000
#
# The server will REFUSE to start in production/staging if any [REQUIRED]
# variable is missing or left as the placeholder value.
#
# Generate secret keys with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
PROJECT_NAME="Lots of Network API"
VERSION="1.0.0"

# ENV controls startup validation and auth cookie security.
#   "development"  -> relaxed validation, HTTP cookies (lax)
#   "staging"      -> all REQUIRED secrets enforced, HTTPS cookies (none/secure)
#   "production"   -> same as staging
#   "test"         -> relaxed, used by pytest
ENV="development"


# -----------------------------------------------------------------------------
# DATABASE  [REQUIRED in production/staging]
# -----------------------------------------------------------------------------
#
# -- Option A: Supabase (recommended for easy cloud hosting) ------------------
#   1. Go to https://supabase.com -> New Project
#   2. Settings -> Database -> Connection String -> URI tab
#   3. Copy the URI (replace [YOUR-PASSWORD] with your DB password)
#
# -- Option B: Self-hosted PostgreSQL (VPS) -----------------------------------
#   DATABASE_URL="postgresql://postgres:[PASSWORD]@localhost:5432/lotsofnetwork"
#
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"


# -----------------------------------------------------------------------------
# JWT SECURITY  [REQUIRED in production/staging]
# -----------------------------------------------------------------------------
#
# Generate BOTH keys independently:
#   python -c "import secrets; print(secrets.token_hex(64))"
#
# SECRET_KEY         -> signs short-lived access tokens (30 min)
# REFRESH_SECRET_KEY -> signs long-lived refresh tokens (30 days)
# They MUST be different strings.
#
SECRET_KEY="replace-with-64-char-random-hex-string"
REFRESH_SECRET_KEY="replace-with-a-different-64-char-random-hex-string"
ALGORITHM="HS256"

# How long access tokens live (minutes). 15-60 is typical.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# How long refresh tokens live (days). 30 days gives a persistent session.
REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0  [REQUIRED in production/staging]
# -----------------------------------------------------------------------------
#
# Steps to get your Google Client ID:
#   1. Go to https://console.cloud.google.com/
#   2. Create or select a project.
#   3. APIs & Services -> Credentials -> "+ Create Credentials" -> OAuth 2.0 Client ID
#   4. Application type: "Web application"
#   5. Authorised JavaScript origins:
#        http://localhost:3000                 (dev)
#        https://lotsofnetwork.com            (prod)
#        https://admin.lotsofnetwork.com      (prod admin)
#   6. Authorised redirect URIs: (leave empty -- we use ID token flow, not redirect)
#   7. Copy the "Client ID" value below.
#
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"


# -----------------------------------------------------------------------------
# ADMIN ACCESS
# -----------------------------------------------------------------------------
#
# Comma-separated Gmail or Google Workspace email addresses.
# These users are automatically assigned role="admin" on first Google sign-in.
# Example:
#   ADMIN_EMAILS="you@gmail.com,partner@yourcompany.com"
#
ADMIN_EMAILS="your-admin@gmail.com"


# -----------------------------------------------------------------------------
# CORS -- Allowed Frontend Origins
# -----------------------------------------------------------------------------
#
# Comma-separated list of every domain that calls this API.
# Include both localhost ports for local development.
#
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://lotsofnetwork.com,https://admin.lotsofnetwork.com"


# -----------------------------------------------------------------------------
# CLOUDINARY CDN  [Optional -- falls back to local /uploads/ storage]
# -----------------------------------------------------------------------------
#
# Used for ad banner images and article cover images.
# If not set, files are stored locally in /uploads/ (fine for dev, not for prod).
#
# Steps to get your Cloudinary URL:
#   1. Go to https://cloudinary.com -> Sign up / Log in
#   2. Dashboard -> "API Keys" section
#   3. Copy the "API environment variable" -- it looks like:
#        cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz123456@your-cloud-name
#
# Set CLOUDINARY_URL only (this overrides the individual fields below).
CLOUDINARY_URL=""

# Or set individually (only if NOT using CLOUDINARY_URL above):
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""


# -----------------------------------------------------------------------------
# STRIPE BILLING  [Required only when BILLING_ENABLED=true]
# -----------------------------------------------------------------------------
#
# Steps to set up Stripe:
#   1. Go to https://dashboard.stripe.com -> Developers -> API Keys
#   2. Copy "Secret key"      -> STRIPE_SECRET_KEY      (starts with sk_live_ or sk_test_)
#   3. Copy "Publishable key" -> STRIPE_PUBLISHABLE_KEY (starts with pk_live_ or pk_test_)
#
#   4. Create Products & Prices in Stripe:
#      Dashboard -> Products -> Add Product
#      - "Pro Developer"  -> $29/month  -> copy Price ID (price_xxxx)
#      - "Enterprise"     -> $199/month -> copy Price ID
#      Then update your plans table:
#        UPDATE plans SET stripe_price_id='price_xxx' WHERE slug='pro';
#        UPDATE plans SET stripe_price_id='price_yyy' WHERE slug='enterprise';
#
#   5. Set up Webhook:
#      Dashboard -> Developers -> Webhooks -> "+ Add endpoint"
#      Endpoint URL: https://api.lotsofnetwork.com/api/v1/billing/webhook
#      Events to listen for:
#        [x] checkout.session.completed
#        [x] customer.subscription.deleted
#        [x] customer.subscription.updated
#      Copy "Signing secret" -> STRIPE_WEBHOOK_SECRET (starts with whsec_)
#
#   6. Set BILLING_ENABLED=true when you are ready to accept payments.
#
# Use test keys (sk_test_, pk_test_) during development.
#
BILLING_ENABLED=false
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"


# -----------------------------------------------------------------------------
# RATE LIMITING -- Anonymous Web Users (no API key)
# -----------------------------------------------------------------------------
#
# Max requests per IP per minute for anonymous web tool access.
# API key holders bypass this limit and are metered by their monthly quota instead.
# Recommended: 10-30 for public production, 100 for local dev.
#
ANON_RATE_LIMIT_PER_MINUTE=20
