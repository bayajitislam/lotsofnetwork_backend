# =============================================================================
# Lots of Network API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED before
# running the server in production. The server will refuse to start in
# production/staging if any REQUIRED variable is missing.
#
# Generate secret keys with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PROJECT_NAME="Lots of Network API"
VERSION="1.0.0"

# ENV controls behaviour: "development" | "staging" | "production" | "test"
# - "development" / "test": relaxed startup validation, SQLite fallback allowed
# - "production" / "staging": all REQUIRED secrets must be present
ENV="production"


# -----------------------------------------------------------------------------
# Database (REQUIRED in production)
# -----------------------------------------------------------------------------
# Supabase (development):
#   postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#   (Both postgresql:// and postgresql+psycopg:// URLs are automatically supported)
#
# VPS PostgreSQL (production):
#   postgresql://postgres:[PASSWORD]@localhost:5432/lotsofnetwork
#
# Local SQLite (dev/test fallback — only if DATABASE_URL is empty AND ENV=development):
#   Leave empty — sqlite:///./lotsofnetwork.db will be used automatically
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"


# -----------------------------------------------------------------------------
# Security & JWT Tokens (REQUIRED in production)
# Generate both with: python -c "import secrets; print(secrets.token_hex(64))"
# -----------------------------------------------------------------------------
SECRET_KEY="generate-a-64-char-random-hex-string-here"
REFRESH_SECRET_KEY="generate-a-different-64-char-random-hex-string-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# Google OAuth 2.0 (REQUIRED in production)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"


# -----------------------------------------------------------------------------
# Admin Access
# Comma-separated Google account emails that receive the 'admin' role on first login.
# -----------------------------------------------------------------------------
ADMIN_EMAILS="your-admin@yourdomain.com"


# -----------------------------------------------------------------------------
# CORS (comma-separated allowed origins)
# Include every domain that will call this API (main website + admin).
# -----------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://lotsofnetwork.com,https://admin.lotsofnetwork.com"


# -----------------------------------------------------------------------------
# Cloudinary CDN (optional — falls back to local /uploads storage if not set)
# Recommended: set CLOUDINARY_URL only (simplest, includes all credentials).
# Get from: Cloudinary Console → Dashboard → API Keys
# Format:  cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# -----------------------------------------------------------------------------
CLOUDINARY_URL=""
# Or set individually (only if not using CLOUDINARY_URL):
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""


# -----------------------------------------------------------------------------
# Stripe Billing (required only when BILLING_ENABLED=true)
# Get from: Stripe Dashboard → Developers → API Keys
# Webhook secret from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
# -----------------------------------------------------------------------------
BILLING_ENABLED=false
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"


# -----------------------------------------------------------------------------
# Rate Limiting (anonymous web users — no API key)
# -----------------------------------------------------------------------------
ANON_RATE_LIMIT_PER_MINUTE=100
