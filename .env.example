# Lots of Network - API Environment Variables

# Project & Environment ("development" | "staging" | "production")
PROJECT_NAME="Lots of Network API"
VERSION="1.0.0"
ENV="development"

# Database (Default: SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./lotsofnetwork.db"
# Production Postgres example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/lotsofnetwork"

# Security & JWT Token Keys (Must be 64-character random hex strings in production)
SECRET_KEY="dev-access-secret-key-change-in-production-lotsofnetwork-2026"
REFRESH_SECRET_KEY="dev-refresh-secret-key-change-in-production-lotsofnetwork-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30      # 30-minute short-lived access token
REFRESH_TOKEN_EXPIRE_DAYS=14        # 14-day refresh token

# Google Cloud OAuth 2.0 Web Client ID (from Google Cloud Console Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Development-only bypass: Set to true ONLY to test auth without live Google Client ID
# STRICTLY FORBIDDEN and automatically rejected when ENV="production"
ALLOW_DEV_MOCK_AUTH=true

# Admin Whitelist (comma-separated lowercase emails with administrator access)
ADMIN_EMAILS="realbayajitislam@gmail.com,contact@bayajitislam.com"

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://lotsofnetwork.com,https://admin.lotsofnetwork.com"
